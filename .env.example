# DocFlow document parser. Copy this file to .env and never commit the token.
OCR_PROVIDER=mineru
MINERU_API_TOKEN=replace-with-token-from-mineru-api-management
MINERU_API_BASE_URL=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=ch
MINERU_FORCE_OCR=true
MINERU_ENABLE_TABLE=true
MINERU_ENABLE_FORMULA=true
MINERU_TIMEOUT_SECONDS=600
MINERU_POLL_INTERVAL_SECONDS=3

# If a local Docling service is already running, use it when MinerU is unavailable.
MINERU_FALLBACK_TO_DOCLING=true
# DOCLING_SERVE_URL=http://127.0.0.1:5001
# DOCLING_SERVE_API_KEY=replace-me
