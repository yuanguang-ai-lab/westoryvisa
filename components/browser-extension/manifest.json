{
  "manifest_version": 3,
  "name": "WestoryVisa DS-160 Autofill",
  "version": "1.0.5",
  "description": "读取 WestoryVisa 服务器字段计划，在当前 CEAC DS-160 页面填写、校验并连续进入下一页。",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://westoryvisa.com/*",
    "https://ceac.state.gov/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "DocFlow Page Agent",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://westoryvisa.com/*"
      ],
      "js": [
        "docflow-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://ceac.state.gov/GenNIV/*"
      ],
      "js": [
        "ceac-postback-monitor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://ceac.state.gov/GenNIV/*"
      ],
      "js": [
        "agent-core.js",
        "ceac-agent.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": "",
  "homepage_url": "https://westoryvisa.com/extension.html"
}
