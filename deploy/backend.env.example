# Copy this file to deploy/backend.env on the server.
# Never commit the resulting backend.env file.

# Browser origin is only needed when the frontend calls the API directly from
# another origin. The bundled Nginx setup proxies /api and remains same-origin.
DOCFLOW_ALLOWED_ORIGINS=https://visa.example.com
DOCFLOW_COOKIE_SAMESITE=Lax
DOCFLOW_COOKIE_SECURE=true
# DOCFLOW_COOKIE_DOMAIN=.example.com

# Email verification
REGISTRATION_VERIFICATION_MODE=email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
MAIL_FROM=visa@example.com
MAIL_FROM_NAME=WestoryVisa

# Landing Page 预约演示通知。请填写实际收件邮箱；未填写时依次使用
# MERCHANT_SUPPORT_EMAIL 和 MAIL_FROM。
DEMO_REQUEST_RECIPIENT_EMAIL=owner@example.com

# Public merchant disclosures. Real checkout stays disabled until the required
# legal name, BRN, address and support email are configured.
MERCHANT_LEGAL_NAME_EN=replace-with-hong-kong-legal-name
MERCHANT_LEGAL_NAME_ZH=
MERCHANT_BUSINESS_REGISTRATION_NUMBER=replace-with-brn
MERCHANT_REGISTERED_ADDRESS=replace-with-registered-or-business-address
MERCHANT_SUPPORT_EMAIL=support@westoryvisa.com
MERCHANT_SUPPORT_PHONE=
MERCHANT_SUPPORT_HOURS=Monday-Friday 09:00-18:00 HKT
MERCHANT_REFUND_WINDOW_DAYS=7
BILLING_PUBLIC_BASE_URL=https://westoryvisa.com

# pending_selection | alipay_cross_border | wechat_pay_cross_border |
# hk_acquirer | stripe
PAYMENT_PROVIDER=pending_selection

# Document parsing. Keep the token in the backend environment only.
OCR_PROVIDER=mineru
MINERU_API_TOKEN=replace-me
MINERU_API_BASE_URL=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=ch
MINERU_FORCE_OCR=true
MINERU_ENABLE_TABLE=true
MINERU_ENABLE_FORMULA=true
MINERU_TIMEOUT_SECONDS=600
MINERU_POLL_INTERVAL_SECONDS=3
MINERU_FALLBACK_TO_DOCLING=true

# Optional local fallback
DOCLING_SERVE_URL=http://host.docker.internal:5001
DOCLING_SERVE_API_KEY=replace-me

# Optional translation services
DS160_TRANSLATION_PROVIDER=auto
LIBRETRANSLATE_URL=http://host.docker.internal:5000
OLLAMA_URL=http://host.docker.internal:11434

# Add provider-specific merchant IDs, endpoints and signing material only after
# receiving the approved provider's official integration package. Never commit
# live values or KYC documents.
