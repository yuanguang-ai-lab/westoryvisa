# Copy to deploy/production.env on the server and keep it private.
DOCFLOW_BIND_ADDRESS=127.0.0.1
DOCFLOW_PUBLIC_PORT=8080
DOCFLOW_COOKIE_SECURE=true

# Optional document parsing. Leave OCR_PROVIDER=auto when no MinerU token exists.
OCR_PROVIDER=auto
# MINERU_API_TOKEN=replace-me

# Billing secrets belong in deploy/backend.env, not in this file.
