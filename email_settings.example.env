# 建议直接运行“配置邮箱验证.command”，它会安全更新项目根目录的 .env。
# 不要把真实授权码、Client Secret 或 Refresh Token 提交到 GitHub。

# 方式一：普通 SMTP（用户名 + SMTP 授权码）
export REGISTRATION_VERIFICATION=email
export MAIL_PROVIDER=smtp
export MAIL_FROM=noreply@example.com
export MAIL_FROM_NAME='DocFlow DS-160'
export SMTP_HOST=smtp.example.com
export SMTP_PORT=465
export SMTP_SECURE=true
export SMTP_USERNAME=noreply@example.com
export SMTP_PASSWORD=replace-with-smtp-app-password

# 方式二：Microsoft Outlook SMTP OAuth2
# 请注释上面的普通 SMTP 配置，再取消以下各行的注释。
# 个人 Outlook/Hotmail 使用 consumers + smtp-mail.outlook.com。
# Microsoft 365 使用租户 ID + smtp.office365.com。
# export MAIL_PROVIDER=microsoft_oauth2
# export REGISTRATION_VERIFICATION=email
# export MAIL_FROM=sender@outlook.com
# export MAIL_FROM_NAME='DocFlow DS-160'
# export MICROSOFT_TENANT_ID=consumers
# export MICROSOFT_CLIENT_ID=replace-with-application-client-id
# export MICROSOFT_CLIENT_SECRET=replace-with-client-secret-value
# export MICROSOFT_REFRESH_TOKEN=replace-with-refresh-token
# export SMTP_HOST=smtp-mail.outlook.com
# export SMTP_PORT=587
# export SMTP_SECURE=false
