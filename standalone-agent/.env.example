# DocFlow provider routing preset. API keys remain secret environment values.
# Shared vendor credentials. Capability-specific *_API_KEY values below can
# override these when separate keys are required.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
MINERU_API_TOKEN=
PADDLEOCR_ACCESS_TOKEN=

DOCUMENT_PARSER_PROVIDER=mineru
DOCUMENT_PARSER_MODEL=vlm
DOCUMENT_PARSER_API_BASE_URL=https://mineru.net
DOCUMENT_PARSER_API_KEY=
DOCUMENT_PARSER_VERSION=

OCR_PROVIDER=mineru
OCR_MODEL=vlm
OCR_API_BASE_URL=https://mineru.net
OCR_API_KEY=
OCR_VERSION=

# MinerU is primary for image OCR; PaddleOCR is the failure/blank-output fallback.
OCR_FALLBACK_PROVIDER=paddle
OCR_FALLBACK_MODEL=PP-OCRv6
OCR_FALLBACK_API_BASE_URL=official
OCR_FALLBACK_API_KEY=
OCR_FALLBACK_VERSION=

# Structured field extraction was the missing model slot in the original map.
EXTRACTION_PROVIDER=deepseek
EXTRACTION_MODEL=deepseek-v4-flash
EXTRACTION_API_BASE_URL=https://api.deepseek.com
EXTRACTION_API_KEY=
EXTRACTION_VERSION=

REVIEW_PROVIDER=deepseek
REVIEW_MODEL=deepseek-v4-flash
REVIEW_API_BASE_URL=https://api.deepseek.com
REVIEW_API_KEY=
REVIEW_VERSION=

TRANSLATION_PROVIDER=deepseek
TRANSLATION_MODEL=deepseek-v4-flash
TRANSLATION_API_BASE_URL=https://api.deepseek.com
TRANSLATION_API_KEY=
TRANSLATION_VERSION=

# Gemini 官方原生 Computer Use。完整项目启动器会保留这些配置。
COMPUTER_USE_PROVIDER=google
COMPUTER_USE_MODEL=gemini-3.6-flash
COMPUTER_USE_API_BASE_URL=https://generativelanguage.googleapis.com
COMPUTER_USE_API_KEY=
COMPUTER_USE_VERSION=
AGENT_COMPUTER_USE_EXECUTION=visual

BROWSER_PROVIDER=playwright
BROWSER_MODEL=chromium
BROWSER_API_BASE_URL=
BROWSER_API_KEY=
BROWSER_VERSION=
# Chrome startup is separately bounded; allowed deployment range is 5–60s.
AGENT_BROWSER_STARTUP_TIMEOUT_SECONDS=30

AGENT_HOST=127.0.0.1
AGENT_PORT=8765
AGENT_DATA_DIR=./agent-data

# Generate with:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AGENT_CHECKPOINT_ENCRYPTION_KEY=
AGENT_ALLOW_PLAINTEXT_CHECKPOINTS=false
AGENT_CHECKPOINT_RETENTION_DAYS=7
